{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@my-agent/core": ["./packages/core/src/index.ts"],
			"@my-agent/core/protocol": ["./packages/core/src/protocol.ts"],
			"@my-agent/core/tools": ["./packages/core/src/tools/index.ts"]
		}
	},
	"include": [
		"packages/core/src/**/*.ts",
		"packages/server/src/**/*.ts",
		"scripts/cdp.ts",
		"scripts/smoke-projection.ts",
		"scripts/smoke-subscribe.ts",
		"scripts/fake-transport.ts",
		"scripts/mount-session.ts",
		"scripts/smoke-default-model.ts",
		"scripts/wire/**/*.ts",
		"scripts/smoke-mux.ts",
		"scripts/smoke-liveness.ts",
		"scripts/smoke-backpressure.ts",
		"scripts/smoke-desktop-close.ts",
		"scripts/smoke-desktop-observability.ts",
		"scripts/smoke-session.ts",
		"scripts/smoke-settings.ts",
		"scripts/smoke-engine-settings.ts",
		"scripts/smoke-session-settings.ts",
		"scripts/smoke-ui-settings.ts",
		"scripts/smoke-tools.ts",
		"scripts/smoke-sessions.ts",
		"scripts/smoke-approval.ts",
		"scripts/smoke-approval-endpoint.ts",
		"scripts/smoke-approval-queue.ts",
		"scripts/smoke-approval-recovery.ts",
		"scripts/smoke-models.ts",
		"scripts/smoke-model-manager.ts"
	]
}
