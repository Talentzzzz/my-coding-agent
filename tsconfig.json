{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@my-agent/llm": ["./packages/llm/src/index.ts"],
			"@my-agent/llm/api/*": ["./packages/llm/src/api/*.ts"],
			"@my-agent/core": ["./packages/core/src/index.ts"],
			"@my-agent/core/protocol": ["./packages/core/src/protocol.ts"],
			"@my-agent/core/tools": ["./packages/core/src/tools/index.ts"]
		}
	},
	"include": [
		"packages/core/src/**/*.ts",
		"packages/server/src/**/*.ts",
		"scripts/cdp.ts",
		"scripts/smoke-projection.ts",
		"scripts/fake-transport.ts",
		"scripts/mount-session.ts",
		"scripts/smoke-default-model.ts",
		"scripts/wire/**/*.ts",
		"scripts/smoke-mux.ts",
		"scripts/smoke-liveness.ts",
		"scripts/smoke-backpressure.ts",
		"scripts/smoke-desktop-close.ts",
		"scripts/smoke-desktop-observability.ts"
	]
}
