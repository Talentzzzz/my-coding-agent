{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		// `node`, although this package runs in a browser: `@my-agent/core/protocol` is the wire
		// vocabulary, and it names `AgentSessionEvent` from `core/src/agent.ts` and `BashSettings` from
		// `core/src/config.ts`, which reach `node:fs`, `node:os`, and `Buffer` in their own source. The
		// imports are type-only and never bundled, but a check that cannot see Node's types cannot see
		// those modules either.
		"types": ["node"],
		"moduleResolution": "bundler",
		"module": "ESNext",
		"baseUrl": "../..",
		"paths": {
			"@my-agent/core/protocol": ["./packages/core/src/protocol.ts"]
		}
	},
	// The smokes are included here rather than in the root project because they import this package's
	// sources, and they need the same `lib` they do — the reducer touches `document` for the theme, and
	// a check without the DOM types would fail on code the package legitimately contains.
	"include": [
		"src/**/*.ts",
		"../../scripts/smoke-mux-client.ts",
		"../../scripts/smoke-mux-live.ts",
		"../../scripts/smoke-sidebar.ts"
	]
}
